	\cf2 -3			ReturnStel's system\cf0 \
	128-2175		ID number of a specific system\
	\cf2 5000-7047		In this system, or any systems adjacent to it\
\cf0 	9999-10255		Any system belonging to this govt\
	\cf2 15000-15255	Any system belonging to this govt or its allies\cf0 \
	20000-20255	Any system not belonging to this govt\
	\cf2 25000-25255	Any system belonging to enemies of this govt\cf0 \
	30000-30255	Any system of a specific govt or any of its class mates\
	\cf2 31000-31255	Any system not of specific govt nor of any of its class mates\cf0 \
\
